<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/toolbar_row_padding"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add"
                style="@style/Widget.Congmingpay.ToolbarButton.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="新增" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh"
                style="@style/Widget.Congmingpay.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="刷新" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test_print"
                style="@style/Widget.Congmingpay.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="测试打印" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sample"
                style="@style/Widget.Congmingpay.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="打印样票" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_json_test"
                style="@style/Widget.Congmingpay.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JSON测试" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_props"
                style="@style/Widget.Congmingpay.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="属性" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                style="@style/Widget.Congmingpay.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="删除"
                android:textColor="@color/status_failed" />

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/content_padding"
        android:paddingEnd="@dimen/content_padding"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/spinner_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/toolbar_btn_min_height" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="@dimen/toolbar_btn_min_height"
            android:hint="搜索名称/IP"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="@dimen/toolbar_btn_text_size" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_printers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无打印机，点击「新增」添加"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

</LinearLayout>
